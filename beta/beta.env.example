# Copy to beta/beta.env in a fresh checkout. Never add real credentials to Git.
OPENAI_API_KEY=
LOCAL_VECTOR_TENANT_ID=
# Explicitly local-only credentials; never expose this profile publicly.
SECRET_KEY=local-beta-only-secret-not-for-hosted-use
ADMIN_SECRET=local-beta-only-admin-secret-not-for-hosted-use
