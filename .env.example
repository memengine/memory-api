# MemoryOS API environment template
# Copy to .env for local development, or map these names into your AWS task/service env.
# Never commit real secrets.

# -----------------------------------------------------------------------------
# App runtime
# -----------------------------------------------------------------------------
APP_ENV=development
APP_VERSION=dev
SECRET_KEY=change-me-minimum-32-characters
ADMIN_SECRET=change-me-separate-admin-secret-minimum-32-characters
INSTALL_DEV_DEPS=false

# Comma-separated browser origins allowed to call the API. No trailing slashes.
# Production example: https://app.memoryo.dev,https://consent.memoryo.dev,https://operator.memoryo.dev,https://memoryo.dev
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Used in emails, Passport links, OAuth redirects, and connector flows.
CONSENT_APP_BASE_URL=http://localhost:3001
BILLING_UPGRADE_URL=https://memoryo.dev/pricing

# Optional Sentry error monitoring.
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Database, Redis, queue, and vector store
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:your-password@your-db-host:5432/postgres
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT_SECONDS=30

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=memories
QDRANT_TIMEOUT_SECONDS=10
QDRANT_PREFER_GRPC=false
QDRANT_ASYNC_POOL_SIZE=100

# Local Docker Postgres defaults used by docker-compose.yml.
POSTGRES_USER=memoryos
POSTGRES_PASSWORD=memoryos123
POSTGRES_DB=memoryos

# -----------------------------------------------------------------------------
# LLM providers and embeddings
# -----------------------------------------------------------------------------
# Providers without keys are skipped. Keep the order conservative for production.
LLM_PROVIDER_ORDER=gemini,openai,anthropic

GEMINI_API_KEY=
GEMINI_API_KEY_SECRET_NAME=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_SECRET_NAME=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_SECONDS=30

COHERE_API_KEY=
COHERE_API_KEY_SECRET_NAME=

# Local embeddings only if you configure an embedding model row with provider='local'.
LOCAL_EMBEDDING_ENDPOINT=http://localhost:11434/api/embeddings

# Extraction and retrieval tuning.
EXTRACTION_MODEL=gemini-2.5-flash
EXTRACTION_PAYLOAD_RETENTION_DAYS=30
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
RETRIEVAL_L1_CACHE_TTL_SECONDS=5.0
RETRIEVAL_MODEL_ID_CACHE_TTL_SECONDS=60.0
RETRIEVAL_MEMORY_COUNT_CACHE_TTL_SECONDS=30.0
RETRIEVAL_HOT_TIER_CACHE_TTL_SECONDS=2.0
RETRIEVAL_CACHE_READ_TIMEOUT_SECONDS=0.05
RETRIEVAL_REDIS_CACHE_READ_ENABLED=true
RETRIEVAL_OVERFETCH_MULTIPLIER=3

# -----------------------------------------------------------------------------
# Clerk auth and webhooks
# -----------------------------------------------------------------------------
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_JWT_ISSUER=https://your-clerk-instance.clerk.accounts.dev
# Optional override. Defaults to ${CLERK_JWT_ISSUER}/.well-known/jwks.json
CLERK_JWKS_URL=
# Clerk webhook endpoint: https://api.memoryo.dev/v1/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_replace_me




# -----------------------------------------------------------------------------
# Memory Passport / UUI sessions
# -----------------------------------------------------------------------------
# If blank, SECRET_KEY is used. Set separately in production so Passport sessions
# can be rotated independently from API signing secrets.
UUI_SESSION_SECRET=change-me-uui-session-secret-minimum-32-characters

# Fernet key used to encrypt organisation OAuth client secrets at rest.
# Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_CREDENTIAL_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Email delivery for UUI login codes and grant notifications
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# -----------------------------------------------------------------------------
# Billing plan metadata
# -----------------------------------------------------------------------------
# Used by GET /v1/billing/plans. Checkout creation webhooks/routes can be added
# separately when payment provider integration is enabled.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=

# -----------------------------------------------------------------------------
# Rate limits and operational controls
# -----------------------------------------------------------------------------
TENANT_RATE_LIMIT_PER_MINUTE=120

# -----------------------------------------------------------------------------
# AWS / production secret loading
# -----------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
# LocalStack/local development only. Leave empty in real AWS unless explicitly needed.
AWS_ENDPOINT_URL=

# Optional AWS Secrets Manager names for provider keys.
# In production, you can use *_SECRET_NAME instead of raw provider keys above.
# GEMINI_API_KEY_SECRET_NAME and ANTHROPIC_API_KEY_SECRET_NAME are read directly.

# -----------------------------------------------------------------------------
# Multi-region resource fallback for development
# -----------------------------------------------------------------------------
# Production regions are normally loaded from the regions table and AWS Secrets Manager.
# These fallback values are useful only for local/dev region-pool tests.
REGION_IN1_DATABASE_URL=
REGION_IN1_QDRANT_URL=
REGION_IN1_REDIS_URL=
REGION_IN1_QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# LocalStack for local AWS-compatible services
# -----------------------------------------------------------------------------
LOCALSTACK_IMAGE=localstack/localstack:3.8.1
LOCALSTACK_SERVICES=s3,sqs
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_ACKNOWLEDGE_ACCOUNT_REQUIREMENT=1

# -----------------------------------------------------------------------------
# Optional evaluation scripts, not required by the API server
# -----------------------------------------------------------------------------
EVAL_REPORT_PATH=docs/extraction_evaluation_report.md
EVAL_REQUEST_DELAY_SECONDS=7
EVAL_TRANSIENT_RETRY_DELAY_SECONDS=15
EVAL_MAX_EXAMPLES=20

# Note:
# Tenant alert webhook URLs and webhook secrets are stored per tenant in tenant_budgets.
# They are not configured through environment variables.
