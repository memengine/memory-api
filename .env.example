# Database
# Format: postgresql+asyncpg://username:password@host:port/database_name
DATABASE_URL=postgresql+asyncpg://memoryos:memoryos123@localhost:5432/memoryos
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT_SECONDS=30

# Qdrant vector database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=10
QDRANT_PREFER_GRPC=false
QDRANT_ASYNC_POOL_SIZE=100

# Redis
REDIS_URL=redis://localhost:6379/0

# LocalStack for local AWS-compatible services.
# Pinned below latest because newer LocalStack images can require cloud auth.
LOCALSTACK_IMAGE=localstack/localstack:3.8.1
LOCALSTACK_SERVICES=s3,sqs
LOCALSTACK_AUTH_TOKEN=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY_SECRET_NAME=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

# OpenAI
# Needed only if you add/use an embedding model row with provider='openai'
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

# Anthropic
# Needed only if you enable extraction failover to Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_API_KEY_SECRET_NAME=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_SECONDS=30

# LLM extraction failover order. Providers without API keys are skipped.
LLM_PROVIDER_ORDER=gemini,openai,anthropic

# Cohere
# Needed only if you enable embedding failover to Cohere
COHERE_API_KEY=your-cohere-api-key-here
COHERE_API_KEY_SECRET_NAME=

# Local embeddings
# Needed only if you add/use an embedding model row with provider='local'
LOCAL_EMBEDDING_ENDPOINT=http://localhost:11434/api/embeddings

# Extraction
EXTRACTION_MODEL=gemini-2.5-flash

# Embeddings
# Default seeded model is gemini-embedding-001-v1 -> collection 'memories'
# Active embedding provider/model is controlled by the embedding_models table
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
RETRIEVAL_L1_CACHE_TTL_SECONDS=5.0
RETRIEVAL_MODEL_ID_CACHE_TTL_SECONDS=60.0
RETRIEVAL_MEMORY_COUNT_CACHE_TTL_SECONDS=30.0
RETRIEVAL_HOT_TIER_CACHE_TTL_SECONDS=2.0
RETRIEVAL_CACHE_READ_TIMEOUT_SECONDS=0.05
RETRIEVAL_REDIS_CACHE_READ_ENABLED=true
RETRIEVAL_OVERFETCH_MULTIPLIER=3

# Clerk authentication
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_JWT_ISSUER=https://sterling-marmot-18.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_your-clerk-webhook-secret

# Sentry error monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/123

# App settings
APP_ENV=development
# Set true only for local/dev Docker builds when you want pytest, ruff, mypy, etc.
INSTALL_DEV_DEPS=false
SECRET_KEY=generate-a-random-string-here
ADMIN_SECRET=generate-a-separate-32-plus-character-admin-secret
APP_VERSION=dev
# Raw conversation payloads are removed from completed/failed job records after this many days.
EXTRACTION_PAYLOAD_RETENTION_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CONSENT_APP_BASE_URL=http://localhost:3001
# Fernet key used to encrypt organisation OAuth client secrets at rest.
# Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_CREDENTIAL_ENCRYPTION_KEY=

# Billing / upgrade links used in quota and webhook payloads
BILLING_UPGRADE_URL=https://memoryos.io/pricing

# Retriever benchmark
# Used by scripts/benchmark_retrieve_latency.py. These do not affect the API server.
BENCHMARK_API_KEY=
BENCHMARK_EXTERNAL_USER_ID=ajeet
BENCHMARK_TARGET_MEMORY_COUNT=50
BENCHMARK_CALLS=100
BENCHMARK_QUERY=programming language preferences
BENCHMARK_VECTOR_SIZE=1536
BENCHMARK_CACHED_P95_TARGET_MS=300
BENCHMARK_UNCACHED_P95_TARGET_MS=500
BENCHMARK_REDIS_URL=redis://localhost:6379/0
BENCHMARK_QDRANT_URL=http://localhost:6333
BENCHMARK_QDRANT_API_KEY=

# Note:
# Tenant alert webhook URLs and webhook secrets are stored per-tenant in tenant_budgets.
# They are not configured through environment variables.
