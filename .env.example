

# Local development defaults. ECS sets APP_ENV=staging or production explicitly.
APP_ENV=development
APP_VERSION=v1
INSTALL_DEV_DEPS=True



SECRET_KEY=
ADMIN_SECRET=
UUI_SESSION_SECRET=



CORS_ALLOWED_ORIGINS=https://app.memoryo.dev,https://consent.memoryo.dev,https://ops.memoryo.dev,https://memoryo.dev


BILLING_UPGRADE_URL=https://memoryo.dev/pricing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER_MONTHLY_INR=
RAZORPAY_PLAN_STARTER_ANNUAL_INR=
RAZORPAY_PLAN_STARTER_MONTHLY_USD=
RAZORPAY_PLAN_STARTER_ANNUAL_USD=
RAZORPAY_PLAN_GROWTH_MONTHLY_INR=
RAZORPAY_PLAN_GROWTH_ANNUAL_INR=
RAZORPAY_PLAN_GROWTH_MONTHLY_USD=
RAZORPAY_PLAN_GROWTH_ANNUAL_USD=
RAZORPAY_PLAN_SCALE_MONTHLY_INR=
RAZORPAY_PLAN_SCALE_ANNUAL_INR=
RAZORPAY_PLAN_SCALE_MONTHLY_USD=
RAZORPAY_PLAN_SCALE_ANNUAL_USD=


SENTRY_DSN=
# Keep error-monitoring PII disabled unless a documented privacy review explicitly approves it.
SENTRY_SEND_DEFAULT_PII=false






# In staging and production, include ssl=require or sslmode=require (or stronger).
DATABASE_URL=postgresql+asyncpg://postgres:your-password@your-db-host:5432/postgres
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_POOL_TIMEOUT_SECONDS=



# Qdrant vector store
# In staging and production, use an https:// endpoint.
 QDRANT_URL=
 QDRANT_API_KEY=


QDRANT_COLLECTION=
QDRANT_TIMEOUT_SECONDS=
QDRANT_PREFER_GRPC=
QDRANT_ASYNC_POOL_SIZE=


# LLM provider and embeddings

LLM_PROVIDER_ORDER=openai
OPENAI_API_KEY=

# Optional fallback: set this only if the app should fetch the key from AWS
# Secrets Manager at runtime instead of receiving OPENAI_API_KEY directly.
OPENAI_API_KEY_SECRET_NAME=

# Optional legacy/secondary providers. Leave blank unless LLM_PROVIDER_ORDER uses them.
GEMINI_API_KEY=
GEMINI_API_KEY_SECRET_NAME=
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_SECRET_NAME=
COHERE_API_KEY=
COHERE_API_KEY_SECRET_NAME=

OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
EXTRACTION_MODEL=gpt-4o-mini
# Development-only observer. Also requires APP_ENV=development.
IMPORTANCE_SHADOW_ENABLED=false
# Optional development-only raw capture for blinded human review packets.
IMPORTANCE_SHADOW_REVIEW_DIR=

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL_ID=openai-text-embedding-3-small-v1
EMBEDDING_DIMENSIONS=1536


# Extraction and retrieval tuning

EXTRACTION_PAYLOAD_RETENTION_DAYS=30
RETRIEVAL_L1_CACHE_TTL_SECONDS=5.0
RETRIEVAL_MODEL_ID_CACHE_TTL_SECONDS=60.0
RETRIEVAL_MEMORY_COUNT_CACHE_TTL_SECONDS=30.0
RETRIEVAL_HOT_TIER_CACHE_TTL_SECONDS=2.0
RETRIEVAL_CACHE_READ_TIMEOUT_SECONDS=0.05
RETRIEVAL_REDIS_CACHE_READ_ENABLED=true
REDIS_TCP_PREFLIGHT_ENABLED=false
RETRIEVAL_OVERFETCH_MULTIPLIER=3
RETRIEVAL_MIN_SEMANTIC_SCORE=0.315


# Clerk auth and webhooks

CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me



CLERK_JWT_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_JWKS_URL=



# Memory Passport / OAuth connector encryption
OAUTH_CREDENTIAL_ENCRYPTION_KEY=

# tenant-level envelope encryption for stored memory text. 
# until a cloud KMS and the storage migration are both configured.
DATA_ENCRYPTION_PROVIDER=disabled
DATA_ENCRYPTION_KMS_KEY_ID=
# `dual-write` is the first controlled rollout mode. Do not use ciphertext-only
# until all read paths and backfill verification are complete.
DATA_ENCRYPTION_WRITE_MODE=disabled



SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

SMTP_FROM=
EMAIL_FROM=

#Rate limits and operational controls
TENANT_RATE_LIMIT_PER_MINUTE=120
