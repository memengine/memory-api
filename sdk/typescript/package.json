{
  "name": "memoryo-sdk",
  "version": "0.1.2",
  "description": "Zero-runtime-dependency TypeScript SDK for governed, traceable AI memory with MemoryOS.",
  "license": "MIT",
  "author": {
    "name": "MemoryO",
    "email": "support@memoryo.dev",
    "url": "https://memoryo.dev"
  },
  "homepage": "https://docs.memoryo.dev/sdk/typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memengine/memory-api.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/memengine/memory-api/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "memory",
    "governance",
    "provenance",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test:contract": "npm run build && node --test tests/contract.mjs",
    "test:package": "node tests/package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test:package"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
