# Public, local-only starter profile. Copy to .env ONLY in a fresh clone.
# Never use these values for a hosted deployment or add real provider keys here.
APP_ENV=development
APP_VERSION=contributor-local
SECRET_KEY=local-only-secret-not-for-hosted-use
ADMIN_SECRET=local-only-admin-secret-not-for-hosted-use
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgresql+asyncpg://memoryos:contributor_local_only@127.0.0.1:15432/memoryos_contributor
REDIS_URL=redis://127.0.0.1:16379/0
CELERY_BROKER_URL=redis://127.0.0.1:16379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:16379/2
QDRANT_URL=http://127.0.0.1:16333
QDRANT_API_KEY=

# Dummy credentials route local AWS clients to LocalStack, not a real account.
AWS_ENDPOINT_URL=http://127.0.0.1:14566
AWS_DEFAULT_REGION=ap-south-1
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=local-only
AWS_SECRET_ACCESS_KEY=local-only
AWS_EC2_METADATA_DISABLED=true

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
OPENAI_API_KEY_SECRET_NAME=
GEMINI_API_KEY_SECRET_NAME=
ANTHROPIC_API_KEY_SECRET_NAME=
COHERE_API_KEY_SECRET_NAME=
LLM_PROVIDER_ORDER=openai
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL_ID=openai-text-embedding-3-small-v1
EMBEDDING_DIMENSIONS=1536

SENTRY_DSN=
SENTRY_SEND_DEFAULT_PII=false
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWT_ISSUER=
CLERK_JWKS_URL=
OAUTH_CREDENTIAL_ENCRYPTION_KEY=
DATA_ENCRYPTION_PROVIDER=disabled
DATA_ENCRYPTION_WRITE_MODE=disabled

PHASE3A_CONFIRMATION_ENABLED=false
PHASE3A_CONFIRMATION_SHADOW_ENABLED=false
EXPLICIT_PREFERENCE_CLAIMS_ENABLED=false
RUNTIME_PREFERENCE_ENABLED=false
RUNTIME_PREFERENCE_DISCOVERY_ENABLED=false
RUNTIME_TURN_PREPARATION_ENABLED=false
RUNTIME_TARGET_WITHHOLDING_ENABLED=false
RUNTIME_TARGET_RELEASE_ENABLED=false
RUNTIME_PREFERENCE_TENANT_IDS=
UNIVERSAL_EXTRACTION_SHADOW_ENABLED=false
MEMORY_PASSPORT_ENABLED=false
IMPORTANCE_SHADOW_ENABLED=false
MEMORYOS_HOLDOUT_APPROVAL=
